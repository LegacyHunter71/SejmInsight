    "components": {
        "schemas": {
            "UserCreateRequest": {
                "required": [
                    "email",
                    "first_name",
                    "last_name"
                ],
                "type": "object",
                "properties": {
                    "email": {
                        "type": "string"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    }
                }
            },
            "CommentCreateRequest": {
                "required": [
                    "content"
                ],
                "type": "object",
                "properties": {
                    "content": {
                        "maxLength": 2000,
                        "minLength": 0,
                        "type": "string"
                    }
                }
            },
            "LikeResult": {
                "type": "object",
                "properties": {
                    "like_count": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "liked": {
                        "type": "boolean"
                    }
                }
            },
            "UserProfileUpdate": {
                "required": [
                    "first_name",
                    "last_name"
                ],
                "type": "object",
                "properties": {
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    }
                }
            },
            "UserDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "username": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "roles": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "Pageable": {
                "type": "object",
                "properties": {
                    "page": {
                        "minimum": 0,
                        "type": "integer",
                        "format": "int32"
                    },
                    "size": {
                        "minimum": 1,
                        "type": "integer",
                        "format": "int32"
                    },
                    "sort": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            },
            "DeputyListItemDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "first_name": {
                        "type": "string"
                    },
                    "last_name": {
                        "type": "string"
                    },
                    "club": {
                        "type": "string"
                    },
                    "district_name": {
                        "type": "string"
                    },
                    "active": {
                        "type": "boolean"
                    },
                    "attendance_rate": {
                        "type": "number",
                        "format": "double"
                    },
                    "present_votings": {
                        "type": "integer",
                        "format": "int32"
                    }
                }
            },
            "PageDeputyListItemDto": {
                "type": "object",
                "properties": {
                    "total_pages": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "total_elements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "number_of_elements": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "first": {
                        "type": "boolean"
                    },
                    "last": {
                        "type": "boolean"
                    },
                    "pageable": {
                        "$ref": "#/components/schemas/PageableObject"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DeputyListItemDto"
                        }
                    },
                    "number": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "sort": {
                        "$ref": "#/components/schemas/SortObject"
                    },
                    "empty": {
                        "type": "boolean"
                    }
                }
            },
            "PageableObject": {
                "type": "object",
                "properties": {
                    "page_number": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "unpaged": {
                        "type": "boolean"
                    },
                    "paged": {
                        "type": "boolean"
                    },
                    "page_size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "offset": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "sort": {
                        "$ref": "#/components/schemas/SortObject"
                    }
                }
            },
            "SortObject": {
                "type": "object",
                "properties": {
                    "unsorted": {
                        "type": "boolean"
                    },
                    "sorted": {
                        "type": "boolean"
                    },
                    "empty": {
                        "type": "boolean"
                    }
                }
            },
            "PageVotingDto": {
                "type": "object",
                "properties": {
                    "total_pages": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "total_elements": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "number_of_elements": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "first": {
                        "type": "boolean"
                    },
                    "last": {
                        "type": "boolean"
                    },
                    "pageable": {
                        "$ref": "#/components/schemas/PageableObject"
                    },
                    "size": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "content": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/VotingDto"
                        }
                    },
                    "number": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "sort": {
                        "$ref": "#/components/schemas/SortObject"
                    },
                    "empty": {
                        "type": "boolean"
                    }
                }
            },
            "VotingDto": {
                "type": "object",
                "properties": {
                    "voting_id": {
                        "type": "string"
                    },
                    "vote_term": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "proceeding_no": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "voting_no": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "title": {
                        "type": "string"
                    },
                    "vote": {
                        "type": "string",
                        "enum": [
                            "YES",
                            "NO",
                            "ABSTAIN",
                            "NOT_VOTED",
                            "ABSENT"
                        ]
                    },
                    "present": {
                        "type": "boolean"
                    }
                }
            },
            "CommentDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    },
                    "author_name": {
                        "type": "string"
                    },
                    "like_count": {
                        "type": "integer",
                        "format": "int64"
                    },
                    "replies": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CommentDto"
                        }
                    },
                    "created_at": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "deleted": {
                        "type": "boolean"
                    }
                }
            },
            "AdminCommentDto": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "content": {
                        "type": "string"
                    },
                    "author_id": {
                        "type": "string"
                    },
                    "author_name": {
                        "type": "string"
                    },
                    "created_at": {
                        "type": "string",
