                    },
                    "deputy_id": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "vote_term": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "proceeding_no": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "voting_no": {
                        "type": "integer",
                        "format": "int32"
                    },
                    "parent_id": {
                        "type": "string"
                    }
                }
            }
