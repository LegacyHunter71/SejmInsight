                ],
                "operationId": "getDeputyVotings",
                "parameters": [
                    {
                        "name": "deputy_id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "format": "int32"
                        }
                    },
                    {
                        "name": "vote",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
